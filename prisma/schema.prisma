// 4D Commerce — relational schema (PostgreSQL).
// Money is ALWAYS stored as integer minor units (paise / cents). Never floats.
// Orders snapshot everything they need (product, price, tax, address) so history never drifts.

generator client {
  provider = "prisma-client"
  output   = "../server/db/generated"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
  DELETED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_OTP
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttributeKind {
  VARIANT_OPTION // size, colour, storage ... (defines variants)
  SPECIFICATION // descriptive specs (material, weight ...)
}

enum MediaType {
  IMAGE
  VIDEO
  MODEL_3D
}

enum StockMovementType {
  RESTOCK
  SALE
  RESERVE
  RELEASE
  ADJUSTMENT
  RETURN
  DAMAGE
  CORRECTION
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  UNPAID // COD / not yet attempted
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProviderKey {
  COD
  RAZORPAY
  STRIPE
  MOCK
}

enum PaymentAttemptStatus {
  CREATED
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  REACHED_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED_TO_SENDER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  RECEIVED
  REFUND_PENDING
  COMPLETED
  CANCELLED
}

enum ReturnResolution {
  REFUND
  REPLACEMENT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum ContentType {
  HERO
  BANNER
  PROMO
  CAMPAIGN
  ANNOUNCEMENT
}

enum HomeSectionType {
  HERO
  CATEGORY_RAIL
  PRODUCT_RAIL
  CONTENT_BLOCKS
  COLLECTION
  RECENTLY_VIEWED
  PERSONALIZED
  TRUST_BADGES
  CUSTOM
}

enum ProductRelationType {
  RELATED
  SIMILAR
  ACCESSORY
  UPSELL
}

enum TicketStatus {
  OPEN
  PENDING_CUSTOMER
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

// ───────────────────────────── Identity & RBAC ─────────────────────────────

model Role {
  id          String           @id @default(uuid(7))
  key         String           @unique // customer, admin, manager, product_manager ...
  name        String
  description String?
  isSystem    Boolean          @default(false)
  isStaff     Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(uuid(7))
  key         String           @unique // e.g. product:write
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id               String     @id @default(uuid(7))
  email            String     @unique // stored lower-cased
  emailVerifiedAt  DateTime?
  phone            String?    @unique
  phoneVerifiedAt  DateTime?
  name             String
  passwordHash     String
  avatarUrl        String?
  status           UserStatus @default(ACTIVE)
  roleId           String
  role             Role       @relation(fields: [roleId], references: [id])
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  preferences      Json       @default("{}")
  marketingOptIn   Boolean    @default(false)
  ordersCount      Int        @default(0)
  lifetimeValue    Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions          Session[]
  tokens            VerificationToken[]
  addresses         Address[]
  carts             Cart[]
  wishlist          WishlistItem[]
  orders            Order[]
  reviews           Review[]
  reviewVotes       ReviewVote[]
  notifications     Notification[]
  recentlyViewed    RecentlyViewed[]
  couponRedemptions CouponRedemption[]
  returns           ReturnRequest[]
  questions         ProductQuestion[]
  tickets           SupportTicket[]
  auditLogs         AuditLog[]          @relation("AuditActor")

  @@index([roleId])
  @@index([status])
  @@index([createdAt])
  @@index([name])
}

model Session {
  id         String    @id @default(uuid(7))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(uuid(7))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Address {
  id         String      @id @default(uuid(7))
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String      @default("IN")
  type       AddressType @default(HOME)
  isDefault  Boolean     @default(false)
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId, deletedAt])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Brand {
  id             String    @id @default(uuid(7))
  name           String
  slug           String    @unique
  description    String?
  logoUrl        String?
  bannerUrl      String?
  websiteUrl     String?
  isActive       Boolean   @default(true)
  isFeatured     Boolean   @default(false)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  ogImageUrl     String?
  canonicalUrl   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]

  @@index([isActive, isFeatured])
  @@index([name])
}

model Category {
  id             String              @id @default(uuid(7))
  parentId       String?
  parent         Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]          @relation("CategoryTree")
  name           String
  slug           String              @unique
  description    String?
  imageUrl       String?
  bannerUrl      String?
  iconName       String?
  path           String              @default("") // materialised path of slugs: "electronics/phones"
  depth          Int                 @default(0)
  sortOrder      Int                 @default(0)
  isActive       Boolean             @default(true)
  isFeatured     Boolean             @default(false)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  ogImageUrl     String?
  canonicalUrl   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  products       Product[]
  coupons        CouponCategory[]
  attributes     CategoryAttribute[]

  @@index([parentId, sortOrder])
  @@index([isActive, isFeatured])
  @@index([path])
}

model Attribute {
  id           String        @id @default(uuid(7))
  key          String        @unique // "color", "storage", "material"
  name         String
  kind         AttributeKind
  unit         String?
  isFilterable Boolean       @default(false)
  sortOrder    Int           @default(0)
  group        String? // spec group heading e.g. "Display"
  createdAt    DateTime      @default(now())

  categories    CategoryAttribute[]
  productValues ProductAttributeValue[]
  variantValues VariantOptionValue[]

  @@index([kind, isFilterable])
}

model CategoryAttribute {
  categoryId  String
  attributeId String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)

  @@id([categoryId, attributeId])
}

model Tag {
  id       String       @id @default(uuid(7))
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Collection {
  id             String              @id @default(uuid(7))
  name           String
  slug           String              @unique
  description    String?
  imageUrl       String?
  bannerUrl      String?
  isActive       Boolean             @default(true)
  isFeatured     Boolean             @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  sortOrder      Int                 @default(0)
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  products       CollectionProduct[]

  @@index([isActive, isFeatured, sortOrder])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Product {
  id                  String        @id @default(uuid(7))
  name                String
  slug                String        @unique
  shortDescription    String?
  description         String?
  status              ProductStatus @default(DRAFT)
  brandId             String?
  brand               Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId          String
  category            Category      @relation(fields: [categoryId], references: [id])
  productType         String        @default("physical")
  taxRateBps          Int           @default(1800) // 18.00 %
  hsnCode             String?
  isFeatured          Boolean       @default(false)
  isBestseller        Boolean       @default(false)
  isNewArrival        Boolean       @default(false)
  maxQuantityPerOrder Int           @default(10)
  badges              String[]
  highlights          String[]
  searchText          String        @default("")
  publishedAt         DateTime?
  deletedAt           DateTime?

  // Denormalised read-model, maintained by catalog service (see recomputeProductAggregates).
  minPrice        Int     @default(0)
  maxPrice        Int     @default(0)
  maxDiscountPct  Int     @default(0)
  inStock         Boolean @default(false)
  ratingAvg       Decimal @default(0) @db.Decimal(3, 2)
  ratingCount     Int     @default(0)
  ratingBreakdown Json    @default("{}")
  soldCount       Int     @default(0)
  viewCount       Int     @default(0)

  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  ogImageUrl     String?
  canonicalUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants       ProductVariant[]
  media          ProductMedia[]
  tags           ProductTag[]
  attributes     ProductAttributeValue[]
  collections    CollectionProduct[]
  reviews        Review[]
  questions      ProductQuestion[]
  wishlistItems  WishlistItem[]
  recentlyViewed RecentlyViewed[]
  relationsFrom  ProductRelation[]       @relation("RelationFrom")
  relationsTo    ProductRelation[]       @relation("RelationTo")
  couponProducts CouponProduct[]
  orderItems     OrderItem[]

  @@index([status, deletedAt, categoryId])
  @@index([status, deletedAt, brandId])
  @@index([status, deletedAt, createdAt])
  @@index([status, deletedAt, minPrice])
  @@index([status, deletedAt, soldCount])
  @@index([status, deletedAt, ratingAvg])
  @@index([isFeatured])
  @@index([isBestseller])
  @@index([isNewArrival])
}

model ProductAttributeValue {
  id          String    @id @default(uuid(7))
  productId   String
  attributeId String
  value       String
  sortOrder   Int       @default(0)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId, value])
}

model ProductVariant {
  id             String   @id @default(uuid(7))
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String   @unique
  name           String? // "Midnight / 256 GB"
  barcode        String?
  price          Int // payable selling price (minor units)
  compareAtPrice Int? // MRP / strike-through price
  costPrice      Int?
  weightGrams    Int      @default(0)
  taxRateBps     Int? // overrides product rate when set
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  options       VariantOptionValue[]
  inventory     Inventory?
  media         ProductMedia[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  movements     StockMovement[]
  reservations  StockReservation[]
  receiptItems  StockReceiptItem[]
  orderItems    OrderItem[]

  @@index([productId, isActive, sortOrder])
  @@index([price])
}

model VariantOptionValue {
  variantId   String
  attributeId String
  value       String
  swatch      String? // hex colour / image url for UI swatches
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute   Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeId])
  @@index([attributeId, value])
}

model ProductMedia {
  id           String          @id @default(uuid(7))
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type         MediaType       @default(IMAGE)
  url          String
  thumbnailUrl String?
  alt          String?
  width        Int?
  height       Int?
  durationSec  Int?
  isPrimary    Boolean         @default(false)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())

  @@index([productId, sortOrder])
  @@index([variantId])
}

model ProductRelation {
  productId        String
  relatedProductId String
  type             ProductRelationType @default(RELATED)
  sortOrder        Int                 @default(0)
  product          Product             @relation("RelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  related          Product             @relation("RelationTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId, type])
  @@index([relatedProductId])
}

model SearchSynonym {
  id       String   @id @default(uuid(7))
  term     String   @unique
  synonyms String[]
}

model SearchLog {
  id          String   @id @default(uuid(7))
  query       String
  userId      String?
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([query])
}

// ───────────────────────────── Inventory ─────────────────────────────
// available = quantity - reserved.  DB CHECK constraints (see migration) guarantee
// quantity >= 0, reserved >= 0, reserved <= quantity.

model Inventory {
  id                String         @id @default(uuid(7))
  variantId         String         @unique
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int            @default(0) // physically on hand (incl. reserved)
  reserved          Int            @default(0)
  sold              Int            @default(0)
  lowStockThreshold Int            @default(5)
  allowBackorder    Boolean        @default(false)
  updatedAt         DateTime       @updatedAt

  @@index([quantity, reserved])
}

model StockMovement {
  id            String            @id @default(uuid(7))
  variantId     String
  variant       ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type          StockMovementType
  quantityDelta Int // change to on-hand (RESERVE/RELEASE affect reserved only -> 0 here)
  reservedDelta Int               @default(0)
  quantityAfter Int
  reservedAfter Int
  reason        String?
  refType       String? // "order", "receipt", "return" ...
  refId         String?
  actorId       String?
  createdAt     DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([refType, refId])
  @@index([type, createdAt])
}

model StockReservation {
  id        String            @id @default(uuid(7))
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id])
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([orderId, variantId])
  @@index([status, expiresAt])
}

model StockReceipt {
  id        String             @id @default(uuid(7))
  reference String             @unique
  supplier  String?
  note      String?
  actorId   String?
  createdAt DateTime           @default(now())
  items     StockReceiptItem[]
}

model StockReceiptItem {
  id        String         @id @default(uuid(7))
  receiptId String
  receipt   StockReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitCost  Int?

  @@index([receiptId])
  @@index([variantId])
}

// ───────────────────────────── Cart / Wishlist ─────────────────────────────

model Cart {
  id           String     @id @default(uuid(7))
  userId       String? @unique
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken   String?    @unique
  couponCodes  String[]
  currency     String     @default("INR")
  mergedIntoId String?
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]

  @@index([userId])
  @@index([updatedAt])
}

model CartItem {
  id            String         @id @default(uuid(7))
  cartId        String
  cart          Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity      Int
  savedForLater Boolean        @default(false)
  priceAtAdd    Int // used only to warn about price changes; never trusted for totals
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

model WishlistItem {
  id         String          @id @default(uuid(7))
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  priceAtAdd Int
  createdAt  DateTime        @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model RecentlyViewed {
  id         String   @id @default(uuid(7))
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewCount  Int      @default(1)
  viewedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@unique([guestToken, productId])
  @@index([userId, viewedAt])
  @@index([guestToken, viewedAt])
}

// ───────────────────────────── Coupons ─────────────────────────────

model Coupon {
  id                 String             @id @default(uuid(7))
  code               String             @unique // stored upper-cased
  description        String?
  type               CouponType
  value              Int // percent (0-100) or minor-unit amount
  minSubtotal        Int                @default(0)
  maxDiscount        Int?
  usageLimit         Int?
  perUserLimit       Int?
  usedCount          Int                @default(0)
  startsAt           DateTime?
  endsAt             DateTime?
  isActive           Boolean            @default(true)
  firstOrderOnly     Boolean            @default(false)
  isStackable        Boolean            @default(false)
  isPublic           Boolean            @default(false) // shown as an offer on product / cart pages
  restrictedToUserId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  products           CouponProduct[]
  categories         CouponCategory[]
  redemptions        CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model CouponCategory {
  couponId   String
  categoryId String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model CouponRedemption {
  id             String    @id @default(uuid(7))
  couponId       String
  coupon         Coupon    @relation(fields: [couponId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  orderId        String
  discountAmount Int
  releasedAt     DateTime? // set when the order is cancelled/failed -> usage is returned
  createdAt      DateTime  @default(now())

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@index([orderId])
}

// ───────────────────────────── Shipping ─────────────────────────────

model ShippingZone {
  id             String         @id @default(uuid(7))
  name           String
  countries      String[]
  states         String[]
  postalPrefixes String[]
  isDefault      Boolean        @default(false)
  isActive       Boolean        @default(true)
  rates          ShippingRate[]
}

model ShippingMethod {
  id          String         @id @default(uuid(7))
  code        String         @unique // standard, express
  name        String
  carrier     String?
  description String?
  minDays     Int            @default(3)
  maxDays     Int            @default(7)
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  rates       ShippingRate[]
}

model ShippingRate {
  id                String         @id @default(uuid(7))
  zoneId            String
  zone              ShippingZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  methodId          String
  method            ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  baseFee           Int
  perKgFee          Int            @default(0)
  freeAboveSubtotal Int? // free shipping threshold
  minSubtotal       Int            @default(0)

  @@unique([zoneId, methodId])
}

// ───────────────────────────── Orders ─────────────────────────────

model Order {
  id            String        @id @default(uuid(7))
  orderNumber   String        @unique
  invoiceNumber String?       @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(UNPAID)
  currency      String        @default("INR")

  subtotal         Int // sum of line (unit price * qty), tax-inclusive or exclusive per store setting
  discountTotal    Int     @default(0)
  shippingTotal    Int     @default(0)
  taxTotal         Int     @default(0)
  grandTotal       Int
  refundedTotal    Int     @default(0)
  pricesIncludeTax Boolean @default(true)

  couponCodes        String[]
  couponSnapshot     Json?
  shippingMethodCode String?
  shippingSnapshot   Json? // method, zone, eta window, fee
  shippingAddress    Json
  billingAddress     Json
  customerEmail      String
  customerPhone      String?
  customerName       String
  notes              String?
  checkoutKey        String? // idempotency key used to create this order
  pricingSnapshot    Json? // full price breakdown at order time

  placedAt             DateTime?
  paidAt               DateTime?
  confirmedAt          DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  estimatedDeliveryMin DateTime?
  estimatedDeliveryMax DateTime?
  reservationExpiresAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  trackingEvents TrackingEvent[]
  payments       Payment[]
  refunds        Refund[]
  shipments      Shipment[]
  returns        ReturnRequest[]
  reservations   StockReservation[]

  @@unique([userId, checkoutKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerEmail])
  @@index([reservationExpiresAt])
}

model OrderItem {
  id                String          @id @default(uuid(7))
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku               String
  name              String
  variantName       String?
  imageUrl          String?
  brandName         String?
  categoryName      String?
  attributes        Json            @default("{}") // variant option snapshot
  productSnapshot   Json
  unitPrice         Int
  compareAtPrice    Int?
  quantity          Int
  discountAmount    Int             @default(0) // allocated share of order discounts
  taxRateBps        Int
  taxAmount         Int
  lineTotal         Int // (unitPrice*qty - discount) [+ tax if exclusive]
  cancelledQuantity Int             @default(0)
  returnedQuantity  Int             @default(0)
  createdAt         DateTime        @default(now())

  reviews       Review[]
  returnItems   ReturnItem[]
  shipmentItems ShipmentItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id         String       @id @default(uuid(7))
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model TrackingEvent {
  id          String    @id @default(uuid(7))
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  code        String // ORDER_PLACED, PAYMENT_CONFIRMED, SHIPPED, REACHED_HUB ...
  title       String
  description String?
  location    String?
  occurredAt  DateTime  @default(now())
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([orderId, occurredAt])
  @@index([shipmentId])
}

model Shipment {
  id                String          @id @default(uuid(7))
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier           String?
  trackingNumber    String?
  trackingUrl       String?
  status            ShipmentStatus  @default(PENDING)
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             ShipmentItem[]
  events            TrackingEvent[]

  @@index([orderId])
  @@index([trackingNumber])
}

model ShipmentItem {
  shipmentId  String
  orderItemId String
  quantity    Int
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@id([shipmentId, orderItemId])
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id                String               @id @default(uuid(7))
  orderId           String
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProviderKey
  method            String? // card, upi, netbanking, cod ...
  status            PaymentAttemptStatus @default(CREATED)
  amount            Int
  currency          String               @default("INR")
  providerPaymentId String? // provider's order/intent id
  providerChargeId  String? // provider's capture / charge id
  idempotencyKey    String?              @unique
  failureCode       String?
  failureReason     String?
  clientPayload     Json? // what the frontend needs to launch the provider SDK (no secrets)
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  refunds           Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([status, createdAt])
}

model WebhookEvent {
  id          String             @id @default(uuid(7))
  provider    PaymentProviderKey
  eventId     String
  type        String
  status      WebhookStatus      @default(RECEIVED)
  payload     Json
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
}

model Refund {
  id               String         @id @default(uuid(7))
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  paymentId        String?
  payment          Payment?       @relation(fields: [paymentId], references: [id])
  returnRequestId  String?
  returnRequest    ReturnRequest? @relation(fields: [returnRequestId], references: [id])
  amount           Int
  status           RefundStatus   @default(PENDING)
  reason           String?
  providerRefundId String?
  idempotencyKey   String         @unique
  failureReason    String?
  actorId          String?
  processedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
}

model IdempotencyRecord {
  id           String            @id @default(uuid(7))
  scope        String // "checkout", "refund" ...
  key          String
  actorKey     String // user id or guest token
  requestHash  String
  status       IdempotencyStatus @default(IN_PROGRESS)
  responseCode Int?
  response     Json?
  expiresAt    DateTime
  createdAt    DateTime          @default(now())

  @@unique([scope, actorKey, key])
  @@index([expiresAt])
}

// ───────────────────────────── Returns ─────────────────────────────

model ReturnRequest {
  id                String           @id @default(uuid(7))
  number            String           @unique
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id])
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  status            ReturnStatus     @default(REQUESTED)
  resolution        ReturnResolution @default(REFUND)
  reason            String
  details           String?
  evidenceUrls      String[]
  adminNote         String?
  pickupScheduledAt DateTime?
  receivedAt        DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  items             ReturnItem[]
  refunds           Refund[]

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ReturnItem {
  id              String        @id @default(uuid(7))
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
  reason          String?
  restock         Boolean       @default(true)

  @@index([returnRequestId])
  @@index([orderItemId])
}

// ───────────────────────────── Reviews & Q&A ─────────────────────────────

model Review {
  id                 String        @id @default(uuid(7))
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItemId        String?
  orderItem          OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  rating             Int
  title              String?
  body               String?
  isVerifiedPurchase Boolean       @default(false)
  status             ReviewStatus  @default(PENDING)
  helpfulCount       Int           @default(0)
  moderatedById      String?
  moderatedAt        DateTime?
  rejectionReason    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  media              ReviewMedia[]
  votes              ReviewVote[]

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([userId])
}

model ReviewMedia {
  id       String    @id @default(uuid(7))
  reviewId String
  review   Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url      String
  type     MediaType @default(IMAGE)

  @@index([reviewId])
}

model ReviewVote {
  reviewId  String
  userId    String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([reviewId, userId])
}

model ProductQuestion {
  id        String          @id @default(uuid(7))
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  status    QuestionStatus  @default(PENDING)
  createdAt DateTime        @default(now())
  answers   ProductAnswer[]

  @@index([productId, status, createdAt])
}

model ProductAnswer {
  id         String          @id @default(uuid(7))
  questionId String
  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String?
  body       String
  isOfficial Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@index([questionId])
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id        String    @id @default(uuid(7))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // order.placed, payment.succeeded ...
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// Outbox for out-of-band channels (email / sms / whatsapp).
model NotificationDelivery {
  id          String              @id @default(uuid(7))
  channel     NotificationChannel
  recipient   String
  template    String
  payload     Json
  status      DeliveryStatus      @default(QUEUED)
  provider    String?
  providerRef String?
  attempts    Int                 @default(0)
  error       String?
  userId      String?
  createdAt   DateTime            @default(now())
  sentAt      DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

// ───────────────────────────── Content / CMS ─────────────────────────────

model ContentBlock {
  id             String      @id @default(uuid(7))
  type           ContentType
  placement      String // "home.hero", "home.promo", "site.announcement", "category:<slug>"
  title          String
  subtitle       String?
  mediaUrl       String?
  mobileMediaUrl String?
  mediaAlt       String?
  ctaLabel       String?
  ctaUrl         String?
  isActive       Boolean     @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  sortOrder      Int         @default(0)
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([placement, isActive, sortOrder])
}

model HomeSection {
  id        String          @id @default(uuid(7))
  key       String          @unique
  type      HomeSectionType
  title     String?
  subtitle  String?
  config    Json            @default("{}")
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([isActive, sortOrder])
}

model StoreSetting {
  key       String   @id
  value     Json
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── Support ─────────────────────────────

model SupportTicket {
  id           String          @id @default(uuid(7))
  number       String          @unique
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId      String?
  subject      String
  category     String          @default("general")
  status       TicketStatus    @default(OPEN)
  assignedToId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  messages     TicketMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model TicketMessage {
  id        String        @id @default(uuid(7))
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  isStaff   Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ───────────────────────────── Audit & analytics ─────────────────────────────

model AuditLog {
  id           String   @id @default(uuid(7))
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole    String?
  action       String // product.created, order.status_changed ...
  resourceType String
  resourceId   String?
  ip           String?
  userAgent    String?
  requestId    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// Pre-aggregated daily rollup so dashboards never scan the orders table.
model DailySalesStat {
  date         DateTime @id @db.Date
  orders       Int      @default(0)
  itemsSold    Int      @default(0)
  grossRevenue Int      @default(0)
  discounts    Int      @default(0)
  shipping     Int      @default(0)
  tax          Int      @default(0)
  refunds      Int      @default(0)
  cancelled    Int      @default(0)
  newCustomers Int      @default(0)
  computedAt   DateTime @default(now())
}
