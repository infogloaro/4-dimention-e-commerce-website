# ───────────────────────── 4D Commerce — environment ─────────────────────────
# Copy to .env (never commit .env). All values below are placeholders / dev defaults.

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1
# Comma-separated list of extra browser origins allowed to call the API with credentials
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL 15+). `npm run db:up` starts a local container on port 5440.
DATABASE_URL=postgresql://fourd:fourd_dev_pw@localhost:5440/fourd_commerce?schema=public
TEST_DATABASE_URL=postgresql://fourd:fourd_dev_pw@localhost:5440/fourd_commerce_test?schema=public

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-dev-only-secret-change-me-dev-only-secret
SESSION_COOKIE_NAME=fourd_session
SESSION_TTL_DAYS=30
CART_COOKIE_NAME=fourd_cart

# Store defaults
STORE_CURRENCY=INR
STORE_PRICES_INCLUDE_TAX=true
STORE_DEFAULT_COUNTRY=IN
STOCK_RESERVATION_MINUTES=15

# Payments (provider keys are optional — the MOCK provider works with no credentials in dev)
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Media storage: local | s3 | cloudinary
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
CLOUDINARY_URL=

# Notifications: console | smtp | ses | resend ...   (console just logs — dev default)
EMAIL_PROVIDER=console
EMAIL_FROM="4D Commerce <no-reply@4dcommerce.local>"
EMAIL_API_KEY=
SMS_PROVIDER=console
SMS_API_KEY=
WHATSAPP_PROVIDER=console
WHATSAPP_API_KEY=

# Seeding — DEVELOPMENT ONLY. Seed refuses to create demo accounts when NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@4dcommerce.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_PASSWORD=Customer@12345

# Rate limiting (requests per window). Swap the in-memory limiter for Redis when scaling out.
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# Scheduler token for POST /api/v1/jobs/maintenance (min 24 chars; leave empty to disable the endpoint)
JOBS_TOKEN=
# Max pooled DB connections per instance
DB_POOL_MAX=20
